---
import SectionPage from '../../../components/SectionPage.astro';
import { sections } from '../../../lib/legacy';

const page = sections.latex;
const compilerSection = `<section id="compiler">
  <p class="w3-padding">
    <a href="https://ilatex.vercel.app/" class="latex-button latex-app-button" target="_blank" rel="noopener noreferrer">
      <img src="/drautomatica/LaTeX_logo.png" alt="" class="latex-logo">
      iLaTeX en línea
    </a>
  </p>
</section>`;
---
<SectionPage
  source={page.source}
  section="latex"
  title={page.title}
  description={page.description}
  heading="Publicaciones recientes"
  hideSectionHeadingIds={['objetivos']}
  sectionOverrides={{ compiler: compilerSection }}
/>
