---
import SectionPage from '../../../components/SectionPage.astro';
import { sections } from '../../../lib/legacy';

const page = sections.python;
const compilerSection = `<section id="compiler">
  <p class="w3-padding">
    <a href="https://ipython.vercel.app/" class="latex-button python-app-button" target="_blank" rel="noopener noreferrer">
      <i class="fa-brands fa-python" aria-hidden="true"></i>
      iPython en línea
    </a>
  </p>
</section>`;
---
<SectionPage
  source={page.source}
  section="python"
  title={page.title}
  description={page.description}
  heading="Contribuciones y publicaciones"
  hideSectionHeadingIds={['objetivos']}
  sectionOverrides={{ compiler: compilerSection }}
/>
