---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from './EntryList.astro';
import { getEntriesForSection, type SectionId } from '../lib/catalog';
import {
  loadSectionIntro,
  loadSectionIntroParts,
  makeSectionsCollapsible,
  removeSectionLeadingBoldText,
  removeSectionHeadings,
  replaceSectionsById
} from '../lib/legacy';

interface Props {
  source: string;
  section: SectionId;
  title: string;
  description: string;
  heading?: string;
  entriesAfterSectionId?: string;
  collapsibleSectionIds?: string[];
  hideSectionHeadingIds?: string[];
  hideSectionLeadBoldIds?: string[];
  sectionOverrides?: Record<string, string>;
}

const {
  source,
  section,
  title,
  description,
  heading,
  entriesAfterSectionId,
  collapsibleSectionIds = [],
  hideSectionHeadingIds = [],
  hideSectionLeadBoldIds = [],
  sectionOverrides = {}
} = Astro.props;
const introParts = entriesAfterSectionId
  ? loadSectionIntroParts(source, entriesAfterSectionId)
  : { before: loadSectionIntro(source), after: '' };
const strippedBefore = removeSectionLeadingBoldText(
  removeSectionHeadings(replaceSectionsById(introParts.before, sectionOverrides), hideSectionHeadingIds),
  hideSectionLeadBoldIds
);
const strippedAfter = removeSectionLeadingBoldText(
  removeSectionHeadings(replaceSectionsById(introParts.after, sectionOverrides), hideSectionHeadingIds),
  hideSectionLeadBoldIds
);
const before = makeSectionsCollapsible(strippedBefore, collapsibleSectionIds);
const after = makeSectionsCollapsible(strippedAfter, collapsibleSectionIds);
const entries = getEntriesForSection(section);
---

<BaseLayout title={title} description={description}>
  <Fragment set:html={before} />
  <EntryList entries={entries} section={section} heading={heading} />
  {after && <Fragment set:html={after} />}
</BaseLayout>
